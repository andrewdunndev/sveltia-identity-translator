# editors.yml -- per-(identity, repo, path) allowlist
#
# Bundled into the Worker and read once at startup. Default is
# deny-everything: an identity with no entry here cannot sign in or
# write to any repo through the translator, regardless of what the
# service-account PAT could otherwise reach.
#
# Schema:
#   repos:
#     <gitlab-org/repo>:
#       branch: <name>              # the only branch commits may target
#       write_roots:
#         <dir>/**: [<ext>, ...]    # subtree an editor may ever write,
#                                   # and the file types allowed in it
#   <oauth-email>:
#     <gitlab-org/repo>:
#       - <path-glob>               # standard glob, ** for recursive
#
# A write is allowed only when its `file_path` (as sent, not
# URL-decoded) matches one of the repo's write_roots, carries one of
# that root's extensions (case-insensitive; no extension is refused),
# AND matches one of the identity's own globs. The roots bind every
# identity, admins included; a repo with no write_roots or no branch
# accepts no writes. List in write_roots only the paths your Sveltia
# config declares and nothing the build or pipeline reads as code.
# Reads need only an entry under the repo. Check the file with
# `npm run lint:editors`.
#
# Adding a new editor:
#   1. Add their OAuth email as a top-level key.
#   2. List the repos they can write to.
#   3. List the paths within each repo, inside that repo's roots.
#
# Adding a new site:
#   1. Add the repo under `repos` with write_roots taken from its
#      Sveltia config (every collection folder and media_folder).
#   2. Add the GitLab repo path as a key under each editor who should
#      have write access.
#
# Rotating an editor out:
#   Remove the top-level key and deploy. Their next request is denied,
#   reads included, even on an unexpired session, and no new session
#   is minted. Force-revoke every session by rotating JWT_SECRET.

repos:
  your-org/your-site:
    branch: main
    write_roots:
      "src/content/blog/**": &content_types [md, yml, yaml, json]
      "src/content/pages/**": *content_types
      "public/images/uploads/**": &media_types [jpg, jpeg, png, webp, gif, avif, pdf]

# Admin: every CMS-editable path on the site.
admin@example.org:
  your-org/your-site:
    - "src/content/blog/**"
    - "src/content/pages/**"
    - "public/images/uploads/**"

# Editor scoped to blog posts only.
editor@example.org:
  your-org/your-site:
    - "src/content/blog/**"

# Smoke-test identity. scripts/smoke.mjs mints its JWT locally with
# JWT_SECRET to verify the negative path (a write outside the
# allowlist returns 403); this entry alone grants nothing without a
# valid JWT.
smoke_editor@example.org:
  your-org/your-site:
    - "src/content/blog/**"
